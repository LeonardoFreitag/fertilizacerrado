# Banco (consumidas pelo Docker Compose)
DB_USER=
DB_PASSWORD=
DB_NAME=

# Redis (consumida pelo Docker Compose)
REDIS_PASSWORD=

# Conexões (consumidas pela aplicação)
# Dentro do Docker o Compose monta estas URLs a partir das variáveis acima e
# sobrescreve os valores daqui. Preencha apenas para rodar a API ou o Prisma CLI
# direto no host. Senhas com caracteres especiais precisam de URL-encoding.
DATABASE_URL=postgresql://USUARIO:SENHA@localhost:5432/BANCO
REDIS_URL=redis://:SENHA@localhost:6379

# JWT
JWT_SECRET=          # mínimo 32 caracteres
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=  # mínimo 32 caracteres
JWT_REFRESH_EXPIRES_IN=7d

# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# SMTP (HOST, USER e PASS obrigatórias apenas em produção)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@dominio.com.br

# Administrador inicial (opcional) — consumidas por `pnpm prisma db seed`.
# O seed cria o usuário ADMIN com e-mail verificado; executá-lo de novo
# atualiza a senha para o valor atual de ADMIN_PASSWORD.
ADMIN_EMAIL=
ADMIN_PASSWORD=      # mesma política do cadastro: 8+ caracteres, maiúscula, número e especial

# Filas BullMQ (api, worker, etl) usam o mesmo Redis: REDIS_URL acima.
# O `worker` (Node) registra o agendamento semanal (segunda 02:00 America/Sao_Paulo);
# o `etl` (Python) consome `era5-ingest`. Nenhuma variável extra é necessária.

# Copernicus CDS — consumidas pelo serviço `etl` (worker da fila era5-ingest e CLI).
# CDS_API_KEY é o token pessoal da API nova (https://cds.climate.copernicus.eu/profile),
# sem o prefixo "uid:". É preciso aceitar a licença do dataset reanalysis-era5-land no site.
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=

# AWS (produção)
AWS_REGION=
ECR_REGISTRY=
ECR_REPOSITORY=
ECR_REPOSITORY_ETL=
IMAGE_TAG=latest
